			)
		)
		(uuid "3999c504-aad4-47cc-b90c-2bee09d5a5ca")
	)
	(text "ESD Protection"
		(exclude_from_sim no)
		(at 134.62 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5f3da471-06d7-4399-8159-0785dc853b4c")
	)
	(text "Input Filter"
		(exclude_from_sim no)
		(at 25.4 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "639807f0-3523-4283-ad5a-c16082374a2c")
	)
	(text "Amplifier Explanation\nWe don't need an amplifier because the ADC already has one built in.\nAn amplifier is normally there to make a tiny signal big enough for the ADC to read. The ADS131M04 has an \nadjustable amplifier inside it (gain up to 128×), so the bridge's tiny voltage gets boosted before it's measured anyway.\nAt that setting, the ADC's own noise is only about 0.5 µε. That's already finer than we need, and finer than the other\nerrors in the system like wire resistance and drift. An external amplifier would add roughly the same amount of noise \nas the ADC already has, so we'd gain nothing and add parts that can go wrong."
		(exclude_from_sim no)
		(at 166.116 122.174 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9488fb89-a700-46a3-8587-103d2ae2793b")
	)
	(text "Need a 0.1% low drift part"
		(exclude_from_sim no)
		(at 104.648 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "94a3ebec-dd05-438b-9e04-0ccea6260056")
	)
	(text "Shunt calibration switch (TS5A3166, one per channel)\nMCU drives SHUNT_CALx high -> switch closes -> 174k is placed across the bridge arm (SIG+ to GNDA).\nThis simulates a known strain: 350 / (2.0 x (350 + 174k)) = ~1000 µε (GF = 2.0).\nR73 (100k) holds the switch OFF at power-up / reset.\n\nTo calibrate: \n1) switch OFF, record zero reading\n2) SHUNT_CALx HIGH, record new reading\n3) µε per count = 1000 / (reading_on - reading_off)\n4) switch OFF and resume normal measurements"
		(exclude_from_sim no)
		(at 122.936 87.122 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ab58db6e-c8e9-45be-a9a2-bc94e617e77a")
	)
	(text "Quarter: J8 replaces R24\nFit R25, R26, R27 (R24 DNP)"
		(exclude_from_sim no)
		(at 90.17 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bf7b84be-4775-4a26-8efe-0a025d25e0a7")
	)
