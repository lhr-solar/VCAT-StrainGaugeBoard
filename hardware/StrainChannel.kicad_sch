		(exclude_from_sim no)
		(at 29.21 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2120b15f-41d1-49a9-afce-d41bf200b032")
	)
	(text "Wheatstone Bridge"
		(exclude_from_sim no)
		(at 96.52 19.05 0)
		(effects
			(font
