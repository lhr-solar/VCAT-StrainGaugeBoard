	(text "Use C0G/NP0 for all three caps"
		(exclude_from_sim no)
		(at 37.592 104.394 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0d734cc2-72d0-47ec-a297-332db3fd4ed3")
	)
	(text "S	Bridge output per µε										1.65 µV\nF	ADC range at gain 32										±37.5 mV\nr	That range in strain										±22,700 µε\nq	Strain per ADC count										0.0027 µε (the 24 bits are far finer than you'll ever use)\nn	ADC noise at gain 32, 1 kSPS (from TI's datasheet table)	0.77 µV rms\ne	That noise in strain										0.47 µε rms\np	Worst-case jitter, peak to peak								 ~ 3 µε\ne_{N}	Noise after averaging 16 samples						 ~ 0.12 µε"
		(exclude_from_sim no)
		(at 117.348 143.256 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "140a7efc-862f-49a8-af3d-3270254f1410")
	)
